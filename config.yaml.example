# ====================================
# 阿里云 DashScope API 配置
# ====================================
dashscope:
  # API Key（必填）
  # 获取地址：https://www.alibabacloud.com/help/zh/model-studio/get-api-key
  # 注意：北京和新加坡地域的API Key不同，不可混用
  api_key: your_dashscope_api_key_here

  # API地域选择：beijing 或 singapore（必填）
  # beijing: https://dashscope.aliyuncs.com
  # singapore: https://dashscope-intl.aliyuncs.com
  region: singapore


# ====================================
# 阿里云 OSS 配置
# ====================================
oss:
  # OSS Access Key ID（必填）
  access_key_id: your_oss_access_key_id_here

  # OSS Access Key Secret（必填）
  access_key_secret: your_oss_access_key_secret_here

  # OSS Bucket 名称（必填）
  bucket_name: your_bucket_name_here

  # OSS Endpoint（必填）
  # 格式：{region}.aliyuncs.com
  # 示例：
  #   - 华东1（杭州）: oss-cn-hangzhou.aliyuncs.com
  #   - 华东2（上海）: oss-cn-shanghai.aliyuncs.com
  #   - 华北2（北京）: oss-cn-beijing.aliyuncs.com
  #   - 华南1（深圳）: oss-cn-shenzhen.aliyuncs.com
  #   - 新加坡: oss-ap-southeast-1.aliyuncs.com
  #   - 更多地域: https://help.aliyun.com/zh/oss/user-guide/regions-and-endpoints
  endpoint: oss-cn-shanghai.aliyuncs.com

  # OSS 存储路径配置（可选）
  paths:
    # 上传的图片存储路径前缀
    images: video-creator/images/

    # 上传的音频存储路径前缀
    audios: video-creator/audios/

    # 上传的参考视频存储路径前缀
    reference_videos: video-creator/reference-videos/

    # 生成的视频存储路径前缀
    output_videos: video-creator/output-videos/

  # 签名URL过期时间（秒，默认24小时）（可选）
  url_expiration: 86400


# ====================================
# 应用配置
# ====================================
app:
  # 应用运行端口（可选）
  port: 8000

  # 应用运行主机（可选）
  host: 0.0.0.0

  # 调试模式（可选）
  debug: true

  # 日志级别（可选）
  # 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
  log_level: INFO
